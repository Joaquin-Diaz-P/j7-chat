{
  "name": "j7-chat",
  "version": "0.2.6",
  "description": "Barra de consultas rápidas para macOS que usa Claude Code, Codex y OpenCode, con capturas y voz de Hex.",
  "author": "Joaquin Diaz",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Joaquin-Diaz-P/j7-chat.git"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "tsx spikes/run.ts",
    "dev": "npm run build:helper && npm run icons && node scripts/dev.mjs",
    "build": "npm run icons && electron-vite build",
    "icons": "node scripts/icons.mjs",
    "build:helper": "mkdir -p build && swiftc -O -target arm64-apple-macosx14.0 native/j7-helper/main.swift -o build/j7-helper",
    "dist": "node scripts/dist.mjs",
    "test:e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "sax": "1.6.1",
    "unpdf": "^1.4.0",
    "yauzl": "3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sax": "1.2.7",
    "@types/yauzl": "3.4.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "katex": "^0.19.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.35.5",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8",
    "zustand": "^5.0.16"
  },
  "main": "out/main/index.js"
}
