{
  "name": "j7-chat",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike": "tsx spikes/run.ts",
    "dev": "npm run build:helper && npm run icons && node scripts/dev.mjs",
    "build": "npm run icons && electron-vite build",
    "icons": "node scripts/icons.mjs",
    "build:helper": "mkdir -p build && swiftc -O -target arm64-apple-macosx14.0 native/j7-helper/main.swift -o build/j7-helper"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "2.4.0",
    "@anthropic-ai/claude-agent-sdk": "0.3.318",
    "katex": "^0.19.1",
    "lucide-react": "^1.68.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "shiki": "^4.6.0",
    "unpdf": "^1.4.0",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^24.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-vite": "^6.0.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.8"
  },
  "main": "out/main/index.js",
  "build": {
    "mac": {
      "extendInfo": {
        "LSUIElement": true
      }
    }
  }
}
